# === RahmatBot config ===
BOT_NAME=RahmatBot
# Nama toko (tampil di struk & invoice). Bisa diubah admin via chat: /set toko
STORE_NAME=Digital Store
# Nomor admin dipisah koma, format 628xx tanpa + / spasi (WAJIB DIISI)
ADMIN_NUMBERS=6281234567890
# Nomor WA yang jadi bot, untuk pairing code (tanpa +, contoh 6281234567890)
PHONE_NUMBER=
USE_PAIRING_CODE=true
# Path gambar QRIS statis
QRIS_IMAGE=./assets/qris.png
QRIS_LABEL=RahmatBot • QRIS Statis
# Catatan: BOT_NAME/STORE_NAME/QRIS_IMAGE/QRIS_LABEL bisa diubah admin lewat chat
# (/set bot, /set toko, /qris). Perubahan disimpan di data/settings.json.

# === Fitur grup ===
# Aktifkan bot di grup (true/false)
GROUP_ENABLED=true
# Prefix perintah di grup (bot juga merespons saat di-tag/reply)
GROUP_PREFIX=.
# Whitelist ID grup dipisah koma (kosong = semua grup). Contoh: 1203630xxx@g.us
GROUP_WHITELIST=
# Sambutan otomatis member baru masuk / pamit keluar
GROUP_WELCOME=true
# Template sambutan kustom (opsional). Placeholder: {{member}} {{group}} {{bot}}
GROUP_WELCOME_TEXT=

# === Proteksi lisensi (untuk deploy ke server orang lain) ===
# Kunci lisensi yang kamu berikan ke pemilik server. Kosong = mode dev (dilewati).
LICENSE_KEY=
# URL server lisensi MILIKMU (tanpa slash di akhir). Contoh: https://lisensi.domainmu.com
LICENSE_SERVER=
# WAJIB true saat deploy! Bila true, bot MENOLAK jalan tanpa lisensi valid.
# (Kalau false, bot tetap jalan walau LICENSE_KEY kosong -> hanya untuk develop lokal.)
LICENSE_REQUIRED=false
# Rahasia HMAC untuk memverifikasi balasan server (HARUS SAMA dengan LICENSE_SECRET di server lisensi).
LICENSE_SECRET=GANTI-DENGAN-SECRET-ACAK-KAMU-9f2a7c
# Berapa jam bot boleh jalan tanpa berhasil kontak server (pakai cache terakhir).
LICENSE_GRACE_HOURS=72
# Interval heartbeat cek lisensi (menit). Server bisa mematikan bot dari jauh.
LICENSE_HEARTBEAT_MIN=30
