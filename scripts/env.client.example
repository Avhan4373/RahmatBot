# =====================================================================
#  KONFIGURASI RAHMATBOT — isi sesuai toko Anda, lalu simpan.
# =====================================================================

# --- Identitas toko ---
BOT_NAME=RahmatBot
STORE_NAME=Digital Store
# Nomor admin (penerima notifikasi order & bukti bayar). Format 628xx, tanpa + / spasi.
# Boleh lebih dari satu, pisahkan dengan koma.
ADMIN_NUMBERS=6281234567890

# --- Koneksi WhatsApp ---
# Nomor WA yang dipakai bot (untuk pairing code), format 628xx tanpa +.
PHONE_NUMBER=
USE_PAIRING_CODE=true

# --- QRIS statis ---
QRIS_IMAGE=./assets/qris.png
QRIS_LABEL=QRIS Statis

# --- Fitur grup ---
GROUP_ENABLED=true
GROUP_PREFIX=.
GROUP_WHITELIST=
GROUP_WELCOME=true
GROUP_WELCOME_TEXT=

# =====================================================================
#  LISENSI — JANGAN DIUBAH. Isi LICENSE_KEY dengan kunci dari penjual.
# =====================================================================
# Kunci lisensi Anda (contoh: RB-xxxx-xxxx-xxxx-xxxx)
LICENSE_KEY=
# Server lisensi & rahasia sudah tertanam di dalam aplikasi (tidak perlu diisi).
